# 忽略本地uv环境
*.venv/
.venv/

# 忽略 .env（含 API Key），但保留示例文件
.env
!.env.example

# 忽略数据库缓存
*db/*

# 预先忽略spec工具包

*.vscode
*.specify
*.vs
*specs

#忽略pycache
__pycache__/

# 忽略前端构建产物和依赖
frontend/build/
frontend/node_modules/

# 忽略上传的 PDF 文件
pdf/

# 忽略下载的嵌入模型
llm_model/

# 忽略 Python 字节码
*.pyc
*.pyo

*coderef