#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""测试对话 API 的脚本"""

import json
import time
import requests

BASE_URL = "http://127.0.0.1:8080"

def parse_sse_stream(response):
    """解析 SSE 流，逐事件返回"""
    event_type = None
    data = None
    
    for line in response.iter_lines(decode_unicode=True):
        if not line:
            # 空行表示事件结束
            if event_type and data is not None:
                yield event_type, data
                event_type = None
                data = None
        elif line.startswith("event:"):
            event_type = line[6:].strip()
        elif line.startswith("data:"):
            data_str = line[5:].strip()
            try:
                data = json.loads(data_str)
            except:
                data = data_str
    
    # 处理末尾事件
    if event_type and data is not None:
        yield event_type, data

def test_create_conversation():
    """测试创建新对话"""
    print("\n" + "="*60)
    print("TEST 1: POST /api/chat - 创建新对话")
    print("="*60)
    
    payload = {
        "question": "你好，请简要介绍一下自己"
    }
    
    print(f"请求: POST {BASE_URL}/api/chat")
    print(f"数据: {json.dumps(payload, ensure_ascii=False)}")
    print("\n流式响应:\n")
    
    conversation_id = None
    full_answer = ""
    sources_data = None
    
    try:
        response = requests.post(
            f"{BASE_URL}/api/chat",
            json=payload,
            headers={"Content-Type": "application/json"},
            stream=True,
            timeout=60
        )
        response.raise_for_status()
        
        for event_type, data in parse_sse_stream(response):
            if event_type == "conversation":
                conversation_id = data.get("conversation_id")
                print(f"[✓ conversation] 对话ID: {conversation_id[:20]}...")
                print(f"                 对话名: {data.get('name')}")
            
            elif event_type == "sources":
                sources_data = data.get("sources", [])
                print(f"\n[✓ sources] 检索到 {len(sources_data)} 条文档\n")
                if sources_data:
                    for i, src in enumerate(sources_data[:2], 1):
                        print(f"    {i}. [{src.get('file_name', 'Unknown')}]")
                        print(f"       {src['page_content'][:70]}...")
                    if len(sources_data) > 2:
                        print(f"    ... 共 {len(sources_data)} 条")
                else:
                    print("    (无相关文档)")
                print()
            
            elif event_type == "token":
                token = data.get("content", "")
                full_answer += token
                print(token, end="", flush=True)
            
            elif event_type == "done":
                print(f"\n\n[✓ done] 完成! 回答共 {len(full_answer)} 字符")
            
            elif event_type == "error":
                print(f"\n[✗ error] {data.get('message')}")
    
    except Exception as e:
        print(f"[✗ 错误] {e}")
        return None
    
    return conversation_id

def test_list_conversations(conversation_id):
    """测试获取对话列表"""
    print("\n" + "="*60)
    print("TEST 2: GET /api/conversations - 获取对话列表")
    print("="*60)
    
    try:
        response = requests.get(f"{BASE_URL}/api/conversations", timeout=10)
        response.raise_for_status()
        conversations = response.json()
        
        print(f"[✓] 响应状态: {response.status_code}")
        print(f"[✓] 对话总数: {len(conversations)}")
        
        for i, conv in enumerate(conversations[:3], 1):
            marker = ">>>" if conv['id'] == conversation_id else "   "
            print(f"\n{marker} 对话 #{i}")
            print(f"    ID: {conv['id'][:20]}...")
            print(f"    名: {conv['name'][:40]}")
            print(f"    轮: {len(conv.get('rounds', []))}")
        
        if len(conversations) > 3:
            print(f"\n    ... 及其他 {len(conversations)-3} 个对话")
        
        return conversations
    
    except Exception as e:
        print(f"[✗ 错误] {e}")
        return []

def test_get_conversation_detail(conversation_id):
    """测试获取对话详情"""
    if not conversation_id:
        print("\n" + "="*60)
        print("TEST 3: 跳过 - 没有有效的 conversation_id")
        print("="*60)
        return None
    
    print("\n" + "="*60)
    print(f"TEST 3: GET /api/conversations/... - 获取对话详情")
    print("="*60)
    
    try:
        response = requests.get(f"{BASE_URL}/api/conversations/{conversation_id}", timeout=10)
        response.raise_for_status()
        conversation = response.json()
        
        print(f"[✓] 对话ID: {conversation['id']}")
        print(f"[✓] 对话名: {conversation['name']}")
        print(f"[✓] 创建于: {conversation['created_at']}")
        print(f"[✓] 轮次数: {len(conversation.get('rounds', []))}")
        
        for i, round_item in enumerate(conversation.get('rounds', []), 1):
            print(f"\n    ━ 第 {i} 轮")
            print(f"      问: {round_item['question'][:50]}...")
            print(f"      答: {round_item['answer'][:50]}...")
            print(f"      文档: {len(round_item.get('sources', []))} 条")
        
        return conversation
    
    except Exception as e:
        print(f"[✗ 错误] {e}")
        return None

def test_add_round_to_conversation(conversation_id):
    """测试在现有对话中添加新轮次"""
    if not conversation_id:
        print("\n" + "="*60)
        print("TEST 4: 跳过 - 没有有效的 conversation_id")
        print("="*60)
        return None
    
    print("\n" + "="*60)
    print(f"TEST 4: POST /api/chat - 添加新轮次到对话")
    print("="*60)
    
    payload = {
        "question": "我再问一个问题",
        "conversation_id": conversation_id
    }
    
    print(f"请求: POST /api/chat")
    print(f"问题: {payload['question']}")
    print("\n流式响应:\n")
    
    full_answer = ""
    
    try:
        response = requests.post(
            f"{BASE_URL}/api/chat",
            json=payload,
            headers={"Content-Type": "application/json"},
            stream=True,
            timeout=60
        )
        response.raise_for_status()
        
        for event_type, data in parse_sse_stream(response):
            if event_type == "conversation":
                print(f"[✓ conversation] 使用已有对话")
            elif event_type == "sources":
                srclist = data.get("sources", [])
                print(f"[✓ sources] 检索 {len(srclist)} 条文档\n")
            elif event_type == "token":
                token = data.get("content", "")
                full_answer += token
                print(token, end="", flush=True)
            elif event_type == "done":
                print(f"\n\n[✓ done] 完成")
            elif event_type == "error":
                print(f"\n[✗ error] {data.get('message')}")
    
    except Exception as e:
        print(f"[✗ 错误] {e}")

def test_get_updated_conversation(conversation_id):
    """获取更新后的对话详情"""
    if not conversation_id:
        return None
    
    print("\n" + "="*60)
    print("TEST 4.5: 验证 - 对话含多轮内容")
    print("="*60)
    
    try:
        response = requests.get(f"{BASE_URL}/api/conversations/{conversation_id}", timeout=10)
        response.raise_for_status()
        conversation = response.json()
        
        print(f"[✓] 对话现有轮数: {len(conversation.get('rounds', []))}")
        
        for i, round_item in enumerate(conversation.get('rounds', []), 1):
            print(f"\n    第 {i} 轮: {round_item['question'][:40]}...")
        
        return conversation
    
    except Exception as e:
        print(f"[✗ 错误] {e}")
        return None

def test_delete_conversation(conversation_id):
    """测试删除对话"""
    if not conversation_id:
        print("\n" + "="*60)
        print("TEST 5: 跳过 - 没有有效的 conversation_id")
        print("="*60)
        return
    
    print("\n" + "="*60)
    print(f"TEST 5: DELETE /api/conversations/... - 删除对话")
    print("="*60)
    
    try:
        response = requests.delete(f"{BASE_URL}/api/conversations/{conversation_id}", timeout=10)
        response.raise_for_status()
        result = response.json()
        
        print(f"[✓] 响应状态: {response.status_code}")
        print(f"[✓] {result['message']}")
    
    except Exception as e:
        print(f"[✗ 错误] {e}")

def test_verify_deletion(conversation_id):
    """验证对话已删除"""
    if not conversation_id:
        return
    
    print("\n" + "="*60)
    print("TEST 5.5: 验证 - 对话已删除")
    print("="*60)
    
    try:
        response = requests.get(f"{BASE_URL}/api/conversations/{conversation_id}", timeout=10)
        
        if response.status_code == 404:
            print(f"[✓] 对话已成功删除 (返回 404)")
        else:
            print(f"[✗] 意外: 对话仍存在 ({response.status_code})")
    
    except Exception as e:
        print(f"[✗ 错误] {e}")

def test_error_handling():
    """测试错误处理"""
    print("\n" + "="*60)
    print("TEST 6: 错误处理 - 获取不存在的对话")
    print("="*60)
    
    fake_id = "00000000-0000-0000-0000-000000000000"
    
    try:
        response = requests.get(f"{BASE_URL}/api/conversations/{fake_id}", timeout=10)
        print(f"[✓] 响应状态: {response.status_code}")
        print(f"[✓] 错误信息: {response.json()}")
    
    except Exception as e:
        print(f"[✗ 错误] {e}")

def main():
    print("\n")
    print("╔" + "="*58 + "╗")
    print("║" + " "*58 + "║")
    print("║" + "  RAG 对话模块 - API 综合测试".center(58) + "║")
    print("║" + " "*58 + "║")
    print("╚" + "="*58 + "╝")
    
    # Test 1: Create conversation
    conv_id = test_create_conversation()
    time.sleep(1)
    
    # Test 2: List conversations
    test_list_conversations(conv_id)
    time.sleep(0.5)
    
    # Test 3: Get conversation detail
    test_get_conversation_detail(conv_id)
    time.sleep(0.5)
    
    # Test 4: Add another round
    test_add_round_to_conversation(conv_id)
    time.sleep(1)
    
    # Test 4.5: Verify rounds
    test_get_updated_conversation(conv_id)
    time.sleep(0.5)
    
    # Test 5: Delete conversation
    test_delete_conversation(conv_id)
    time.sleep(0.5)
    
    # Test 5.5: Verify deletion
    test_verify_deletion(conv_id)
    time.sleep(0.5)
    
    # Test 6: Error handling
    test_error_handling()
    
    print("\n" + "="*60)
    print("✓ 所有测试完成!")
    print("="*60 + "\n")

if __name__ == "__main__":
    main()
